{
  "name": "minutes-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "ping-check": "node scripts/ping-check.mjs",
    "kill-dev": "node scripts/kill-dev.mjs",
    "seed-storage": "tsx scripts/seed-storage.ts",
    "download-font": "tsx scripts/download-noto-sans-jp.ts",
    "download-joyo-kanji": "node scripts/download-joyo-kanji-list.mjs",
    "subset-font": "node scripts/subset-noto-sans-jp.mjs",
    "prepare-font": "pnpm download-font && pnpm download-joyo-kanji && pnpm subset-font",
    "verify-font-bundle": "node scripts/verify-font-bundle.mjs",
    "types:gen": "pnpm dlx supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "types:gen:linked": "pnpm dlx supabase gen types typescript --linked > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@hookform/resolvers": "^3.9.1",
    "@mistralai/mistralai": "^2.2.0",
    "@napi-rs/canvas": "^1.0.0",
    "@pdf-lib/fontkit": "^1.1.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.7.4",
    "docxtemplater": "^3.51.2",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.6.0",
    "mammoth": "^1.8.0",
    "nanoid": "^5.0.9",
    "next": "^15.2.6",
    "opentype.js": "^2.0.0",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.0",
    "pdfjs-dist": "^5.7.0",
    "pdfjs-serverless": "^1.2.0",
    "pizzip": "^3.1.7",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-turnstile": "^1.1.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^0.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "^2.101.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
