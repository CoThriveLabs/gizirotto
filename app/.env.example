# ============================================================================
# Gizirotto 環境変数サンプル
# このファイルを .env.local にコピーして実値を埋める（.env.local は git 管理外）。
#   cp .env.example .env.local
# ============================================================================

# === Supabase（新形式キー） ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# === Anthropic（議事録整形・AI チャット） ===
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6-20260301

# === Mistral OCR（スキャン PDF / テーブル領域の OCR・bbox 取得） ===
# 料金: $2/1000 ページ（Batch は $1）
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_OCR_MODEL=mistral-ocr-2512

# === CloudConvert（Word/PDF 変換のフォールバック経路） ===
CLOUDCONVERT_API_KEY=your-cloudconvert-api-key-here

# === Cloudflare Turnstile（bot 対策・サインアップ保護） ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# === Upstash Redis（レートリミット） ===
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# === アプリ ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
# /api/ping の Bearer 認証用。生成例: openssl rand -hex 32
PING_SECRET=replace_with_random_hex_32

# ============================================================================
# 以下は Supabase Edge Function secret として設定する（Vercel env var ではない）。
#   supabase secrets set NOTIFY_FROM=... NOTIFY_TO=... RESEND_API_KEY=...
# ============================================================================
# NOTIFY_FROM=noreply@your-domain.example
# NOTIFY_TO=alerts@your-domain.example
# RESEND_API_KEY=re_your-resend-api-key-here
